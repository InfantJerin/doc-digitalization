# Document Digitalization Platform - Environment Variables

# LLM provider selection: anthropic | openai_compatible | litellm
LLM_PROVIDER=openai_compatible
LLM_API_BASE=
LLM_API_KEY=

# Anthropic / Agent SDK
ANTHROPIC_API_KEY=sk-ant-xxx

# OpenAI (used by openai_compatible/litellm if LLM_API_KEY empty)
OPENAI_API_KEY=sk-proj-xxx

AGENT_MODEL=gpt-4.1-mini
AGENT_PERMISSION_MODE=bypassPermissions

# Document Management System
DMS_BASE_URL=http://localhost:8080
DMS_API_KEY=

# Storage and workspace
EXTRACTIONS_ROOT=/tmp/extractions
SKILLS_DIR=skills

# Database (PostgreSQL preferred, sqlite fallback)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/doc_digitalization

# Webhook URLs (for post-sink delivery)
CORE_BANKING_WEBHOOK_URL=https://core-banking.internal/webhooks/covenants
NOTIFICATION_WEBHOOK_URL=https://notifications.internal/webhooks
DEAL_MANAGEMENT_WEBHOOK_URL=https://deals.internal/webhooks

# Logging
LOG_LEVEL=INFO
ENVIRONMENT=dev
