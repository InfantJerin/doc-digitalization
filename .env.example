# Document Digitalization Platform - Environment Variables

# Anthropic API Key (required)
ANTHROPIC_API_KEY=sk-ant-xxx

# Document Management System
DMS_BASE_URL=http://localhost:8080
DMS_API_KEY=

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/doc_digitalization

# Redis
REDIS_URL=redis://localhost:6379

# AWS (for S3 storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=doc-digitalization

# Webhook URLs (for post-sink delivery)
CORE_BANKING_WEBHOOK_URL=https://core-banking.internal/webhooks/covenants
NOTIFICATION_WEBHOOK_URL=https://notifications.internal/webhooks
DEAL_MANAGEMENT_WEBHOOK_URL=https://deals.internal/webhooks

# Logging
LOG_LEVEL=INFO
